# Backend Environment
NODE_ENV=development
PORT=3000

# GitHub OAuth
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here
# Optional: GitHub App mode (recommended). The app's slug, e.g. pixelgrapher. Leave empty for the old OAuth-app mode.
# In the app's settings: Permissions > Repository > Contents: Read & write, and under Optional Features
# opt out of "User-to-server token expiration" (login tokens are not refreshed).
GITHUB_APP_SLUG=
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Session
SESSION_SECRET=generate-a-strong-random-string-here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

