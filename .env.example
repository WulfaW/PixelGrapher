# GitHub OAuth Configuration
# Create a GitHub OAuth App at: https://github.com/settings/developers
# For local development, use callback URL: http://localhost:5000/api/auth/github/callback
# For production, use your actual domain: https://yourdomain.com/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Session Secret
# IMPORTANT: Generate a strong random string (minimum 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This is REQUIRED in production - app will not start without it
SESSION_SECRET=your-super-secret-session-key-change-this

# Application Port (Backend serves both API and frontend)
PORT=5000

# Environment (development or production)
NODE_ENV=development


